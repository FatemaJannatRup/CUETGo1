# Copy this file to .env and fill in your values

DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres

# Public demo sign-in and sample data (disable for production launch)
DEMO_MODE=true
SEED_DEMO_DATA=true

# Any random long string, used to sign login tokens
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
ADMIN_APPROVAL_KEY=replace_with_a_separate_random_secret_at_least_32_characters_long

# Get a free key from https://aistudio.google.com/app/apikey
# Leave blank to fall back to simple rule-based ride matching
GEMINI_API_KEY=

PORT=5000
